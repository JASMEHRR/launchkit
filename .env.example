# Copy this file to .env (in the project root) and fill in your key.
# The key stays server-side — it is NEVER shipped to the browser.
# Get a free key at https://build.nvidia.com (the token looks like nvapi-...).
NVIDIA_API_KEY=nvapi-...

# Optional: pick a different free model hosted on build.nvidia.com
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Optional: change the API server port (frontend proxy assumes 3001)
PORT=3001
